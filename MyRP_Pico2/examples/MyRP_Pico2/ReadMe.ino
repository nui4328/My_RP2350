
void readme()
  {

    Motor(10 ,10);
    Motor(-10 ,-10);
    Motor(0 ,0);

    
    //--------------------------------->> เซนเซอร์
    //---->> เซนเซอร์หน้า
    read_sensorA(0)                 ;  //ค่าที่อ่านได้จากเซนเซอร์  ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    md_sensorA(0)                   ;  //ค่ากลางระหว่างพื้นขาวกับดำ  ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    sensorMinA[0]                  ;   //ค่าต่ำสุดได้จากการคาริเบรท ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    sensorMaxA[0]                  ;   //ค่ามากสุดได้จากการคาริเบรท ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา

    //---->> เซนเซอร์หลัง
    read_sensorB(0)                 ;  //ค่าที่อ่านได้จากเซนเซอร์  ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    md_sensorB(0)                   ;  //ค่ากลางระหว่างพื้นขาวกับดำ  ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    sensorMinB[0]                  ;   //ค่าต่ำสุดได้จากการคาริเบรท ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    sensorMaxB[0]                  ;   //ค่ามากสุดได้จากการคาริเบรท ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา

    //---->> เซนเซอร์กลาง
    
    analogRead(46)                 ;  //ค่าที่อ่านได้จากเซนเซอร์  ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    md_sensorC(0)                  ;
    sensorMinC[0]                 ;                
    sensorMaxC[0]                 ; 

    analogRead(47)                 ;  //ค่าที่อ่านได้จากเซนเซอร์  ค่าในวงเล็บ 0-7 เรียงจากซ้ายไปขวา
    md_sensorC(1)                  ;
    sensorMinC[1]                 ;                
    sensorMaxC[1]                 ; 

    //  คำสั่งเดินตามเส้น นับทีละแยก

    sensor_position( 50);

     fline(50, 50, 0.25, "30", 'n', 's', 90, "a6", 0);
     fline(40, 40, 0.45, "fl", 'c', 'l', 60, "a1", 10);
     fline(40, 40, 1.25, "fr", 'f', 'l', 90, "a1", 1);
     fline(60, 60, 0.45, "cl", 'c', 'l', 90, "a1", 10);
     fline(40, 40, 0.45, "cr", 'f', 's', 90, "a1", 1);
     fline(40, 40, 0.45, "bl", 'f', 's', 90, "a1", 1);
     fline(40, 40, 0.45, "br", 'f', 's', 90, "a1", 1);

     fw_gyro(30, 30, 1.5,  60, 10);   // ความเร็ว 30 30  kp1.5   ระยะ 60 เซนติเมตร ค่าเบรค 10


     rotate(-1, 30, -45, 10) ;  //---> หมุนซ้าย มอเตอร์ ซ้าย -1   ขวา 30 หมุนไปที่ -45 องศา
     rotate(30, -1,  45, 10) ;  //---> หมุนซ้าย มอเตอร์ ซ้าย 30   ขวา -1 หมุนไปที่  45 องศา

     rotate(-30, 30, -45, 10) ;  //---> หมุนซ้าย มอเตอร์ ซ้าย -30   ขวา 30 หมุนไปที่ -45 องศา
     rotate(30, -30,  45, 10) ;  //---> หมุนซ้าย มอเตอร์ ซ้าย 30   ขวา -30 หมุนไปที่  45 องศา

     place_left_in(30, 90, 10) ;  //---> หมุนซ้ายเข้า มอเตอร์ ซ้าย 0   ขวา 30 หมุนไปที่  90 องศา
     place_left_out(30, 90, 10) ; //---> หมุนซ้ายออก มอเตอร์ ซ้าย 0   ขวา 30 หมุนไปที่  90 องศา

     place_right_in(30, 90, 10) ;  //---> หมุนขวาเข้า มอเตอร์ ซ้าย 0   ขวา 30 หมุนไปที่  90 องศา
     place_right_out(30, 90, 10) ; //---> หมุนขวาออก มอเตอร์ ซ้าย 0   ขวา 30 หมุนไปที่  90 องศา

     setrobot_fline(4);    //--->> เซตหุ่นยนต์ให้ตรง โดยใช้เซนเซอร์หน้า แตะเส้นดำ  4 คือ จำนวนครั้งที่เซต
     setrobot_bline(4);    //--->> เซตหุ่นยนต์ให้ตรง โดยใช้เซนเซอร์sหลัง แตะเส้นดำ  4 คือ จำนวนครั้งที่เซต
  
    //----------------------------------------------------------------------------->>
    arm_ready();  //--------->> แขนลง กางฝ่ามือออกเตรียมเข้าไปคีบ
    arm_open_down();   //--------->>  กางฝ่ามือออก  และเอาแขนลง
    arm_down_open();   //--------->>  เอาแขนลง  และ กางฝ่ามือออก  
    arm_open_up();    //--------->>  กางฝ่ามือออก  และยกแขนขึ้น
    arm_up_open();   //--------->>  เอาแขนขึ้น  และ กางฝ่ามือออก  
    arm_down_close();  //--------->>  เอาแขนลง  และ หุบมือเข้า  
    arm_up_close();   //--------->>  ยกแขนขึ้น  และ หุบมือเข้า  
    arm_big_box();  //--------->>  คีบกล่องใหญ่
  }




