void setup() 
  {    
    robot.setup_robot() ;
    set_motor();
    //bat.setDebug(false);    // ปิด debug ตอนแข่ง
//------------------------>> ตั้งค่า triming เซอร์โวให้ตรง
    robot.s0_trim(0);    
    robot.s1_trim(0);
    robot.s10_trim(0);
    robot.s28_trim(0);
//--------------->> ตั้งค่า triming เซอร์โวให้ตรง    
//------------------------->>  ส่วนของคำสั่งในการเตรียมแขนกล 
    //arm_down_close(); 
    robot.sw();  //--->> คำสั่งรอกดปุ่ม
    //resetAngles();   
////------------------------------------------------------------------------------>> รันคำสั่งต่าง ๆ ที่นี่    
        
    arm_ready();    
    robot.fw_gyro(30, 30, 1.5, 30, 10); 

    robot.sw();

    robot.bw_gyro(30, 30, 1.5, 30, 10); 
  

////------------------------------------------------------------------------------>> จบการรันคำสั่งต่าง ๆ 
  
  }    //--> ห้ามลบออก 





