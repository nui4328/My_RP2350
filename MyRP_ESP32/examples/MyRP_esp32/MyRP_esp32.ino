#include <MyRP_ESP32.h>
MyRP_ESP32 robot;
//----------------------------------------------------------------------------->> ตั้งค่ามือจับ
int servo_down = 45;        //-------------------->> ตั้งค่า มื่อจับลงขนานกับพื้น
int servoL_open = 120;      //-------------------->> ตั้งค่า กางฝ่ามือด้านซ้าย
int servoR_open = 110;      //-------------------->> ตั้งค่า กางฝ่ามือด้านขวา
